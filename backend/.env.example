# Copy to `.env` to override the defaults.
# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to generate a random key and keep it in data/.secret_key.
SECRET_KEY=
# Database (default: SQLite at backend/data/app.db). Use a Postgres URL (e.g. Neon) when hosting on Vercel,
# where every request may hit a different instance.
# DATABASE_URL=sqlite:///C:/path/to/app.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Folder for SQLite, the secret key file and trained ML models (default: backend/data; /tmp/scenario-data on Vercel).
# DATA_DIR=

# Optional: enable Claude in the AI agent (scenario drafting and report writing).
# Create backend/.env (never commit it) and put your key there, then restart the API.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
